# Copy to .env before docker compose up.
#
# Prefer AIRFLOW_UID=50000 (official apache/airflow image user). On macOS,
# $(id -u) is often 501 and has no /etc/passwd entry inside the container
# → KeyError: getpwuid(): uid not found / AirflowConfigException.
# On Linux you may instead use: echo "AIRFLOW_UID=$(id -u)" > .env
AIRFLOW_UID=50000
